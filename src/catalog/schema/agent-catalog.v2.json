{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crusbro.dev/schemas/agent-catalog.v2.json",
  "title": "AgentCatalog v2",
  "type": "object",
  "required": ["schema_version", "system_prompt", "llm"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "system_prompt": { "type": "string", "minLength": 1 },
    "llm": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "api_key_env": { "type": "string", "default": "LLM_API_KEY" }
      },
      "additionalProperties": false
    },
    "skill_roots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolSpec" },
      "default": []
    },
    "gates": {
      "type": "object",
      "properties": {
        "tools_gate": { "type": "object" }
      },
      "additionalProperties": true
    },
    "write_policy": {
      "type": "object",
      "properties": {
        "allowRelativePrefixes": { "type": "array", "items": { "type": "string" } },
        "denyAbsolute": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "notify_emit": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "standard_tool": { "type": "string", "default": "agent.notify" },
        "intent_prefix": { "type": "string" },
        "payload_field_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "contract": { "type": "object" }
  },
  "$defs": {
    "sideEffect": { "enum": ["read", "write_workspace", "outbound"] },
    "toolSpec": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name", "url"],
          "properties": {
            "kind": { "const": "http" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "url": { "type": "string", "minLength": 1 },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "auth_env": { "type": "string" },
            "input_schema": { "type": "object" },
            "side_effect": { "$ref": "#/$defs/sideEffect" },
            "require_approval": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "source_path"],
          "properties": {
            "kind": { "const": "js" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "source_path": { "type": "string", "minLength": 1 },
            "input_schema": { "type": "object" },
            "side_effect": { "$ref": "#/$defs/sideEffect" },
            "require_approval": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "builtin" },
            "name": { "type": "string", "minLength": 1 },
            "side_effect": { "$ref": "#/$defs/sideEffect" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "host_ref" },
            "name": { "type": "string", "minLength": 1 },
            "side_effect": { "$ref": "#/$defs/sideEffect" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
